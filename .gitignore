# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
npm-debug.log*
.next/
# Local npm cache created when npm runs with a project-scoped cache dir.
.npm-cache/

# Env & secrets
.env
.env.local
.env.*.local
!.env.example
*.pem

# Data / runtime
data/
.tmp/
tmp/
*.db
*.sqlite
uploads/
storage/

# Path overrides written by the 模型路由诊断 page (storage root / providers.yaml).
# Machine-specific, must never be committed.
backend/config/runtime.json
backend/config/runtime.json.tmp

# IDE
.idea/
.vscode/
*.swp

# Local assistant/tool scratch state (machine-specific, never shared)
.workbuddy/

# OS
.DS_Store

# Root-level learning media (user's own study materials must never be uploaded)
/*.mp4
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.webp

# Local tool binaries (ffmpeg etc., downloaded on demand)
tools/

# E2E test outputs (LLM-generated notes / Q&A / quiz records about user materials)
test-outputs/
test/

# TypeScript incremental build cache
*.tsbuildinfo

# OCR recognition models: ~10 MB ONNX files fetched on demand.
# Regenerate with: python backend/scripts/fetch_ocr_models.py --lang japan
backend/models/ocr/*.onnx
backend/models/ocr/*.part

# Alembic
# keep versions

# Local verification: service logs and the throwaway output of the acceptance
# scripts (_e2e_layout.py, _check_llm_login.py). The scripts themselves are
# tracked; only their logs are noise.
backend/_uvicorn.log
backend/_e2e_layout.log
frontend/_next.log
