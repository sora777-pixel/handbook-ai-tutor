# =============================================================================
# AI Learning Tutoring Platform — Scope A
# Copy to .env and adjust. Never commit real API keys.
# =============================================================================

# --- App ---
APP_NAME=AI Learning Tutor
SECRET_KEY=change-me-in-production-use-a-long-random-string-at-least-32-bytes
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://tutor:tutor@postgres:5432/tutor
# Sync URL used by Alembic
DATABASE_URL_SYNC=postgresql://tutor:tutor@postgres:5432/tutor

# --- Redis (ARQ + SSE progress) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sources
S3_REGION=us-east-1
S3_SECURE=false

# --- Task backend: arq (compose) | inline (dev/tests without Redis) ---
TASK_BACKEND=arq

# --- Storage: minio | local ---
STORAGE_BACKEND=minio

# Root that holds every account's own folder when STORAGE_BACKEND=local.
# Leave BLANK for local runs: the default is the absolute path
# <repo>/data/storage (regardless of the current working directory), and it can
# be re-pointed at runtime from the 模型路由诊断 page without editing this file.
# Each account gets <root>/<user_id>/{profile,records,resources}; uploaded
# originals go into that account's resources/ sub-folder.
# A non-absolute value is anchored to the repo root, never to the cwd.
# Inside Docker set it explicitly (e.g. /data/storage) — an environment variable
# from compose pins the value and the settings page will report it as locked.
LOCAL_STORAGE_PATH=

# --- RAG: pgvector | llamaindex ---
RAG_PROVIDER=llamaindex
# China-first embed models (SiliconFlow BAAI/bge-m3, DashScope text-embedding-v3)
# are 1024-d. OpenAI text-embedding-3-small is 1536 — raise this if you switch.
# The ingest path also records the vendor's actual vector width.
EMBEDDING_DIM=1024

# --- STT: mock (default, no GPU) | faster_whisper | siliconflow (cloud ASR) ---
STT_PROVIDER=mock
# SiliconFlow cloud ASR (语音转文本). Only used when STT_PROVIDER=siliconflow.
STT_SILICONFLOW_MODEL=FunAudioLLM/SenseVoiceSmall
# 自定义前缀地址（末尾不带 /v1）；默认 https://api.siliconflow.cn/v1
STT_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# faster-whisper model size: base (fast) | small (recommended for Chinese lectures)
STT_WHISPER_MODEL=base
# VAD silence filtering for lecture audio
STT_WHISPER_VAD=true
# Optional: HuggingFace mirror for model download in CN network
# HF_ENDPOINT=https://hf-mirror.com

# --- LLM routing (China-first defaults) ---
# Business code passes task=summarize|extract_knowledge|quiz_generate|quiz_explain
#                             |tutor|notes_generate|segment_summarize|embed
#
# Routing priority (first match wins):
#   1. LLM_TASK_ROUTES   e.g. {"summarize":"deepseek","quiz_explain":"deepseek"}
#   2. providers.yaml -> task_routes
#   3. per-modality vars below (LLM_PROVIDER_TEXT / _AUDIO / _EMBED)
#   4. LLM_DEFAULT_PROVIDER
#   5. providers.yaml -> default_provider
#   6. "mock"
#
# Leave LLM_DEFAULT_PROVIDER empty to auto-detect the first provider that has a
# usable API key (dashscope -> deepseek -> siliconflow -> openai -> anthropic).
# If a real provider is selected but its key is missing/placeholder, the request
# FAILS LOUDLY with LLMConfigError instead of silently falling back to mock.
LLM_DEFAULT_PROVIDER=

# Per-modality routing — text (summarize/quiz/tutor), audio (speech), embed (RAG)
# e.g. LLM_PROVIDER_TEXT=deepseek, LLM_PROVIDER_AUDIO=dashscope
LLM_PROVIDER_TEXT=
LLM_PROVIDER_AUDIO=
# Embeddings must be a vendor that declares an embed model.
# DeepSeek has chat only — never send deepseek-chat to /embeddings.
# Examples: siliconflow (BAAI/bge-m3) or dashscope (text-embedding-v3).
LLM_PROVIDER_EMBED=

# Vision routing — transcribe_image (reading images / scanned-PDF books, i.e. OCR).
# Leave BLANK to auto-pick the first provider that declares a `transcribe_image`
# model in providers.yaml (dashscope -> openai -> siliconflow -> anthropic -> ollama).
# DeepSeek has no vision model, so it can NEVER be picked for this task.
# e.g. LLM_PROVIDER_VISION=dashscope   (qwen-vl-max, needs DASHSCOPE_API_KEY)
LLM_PROVIDER_VISION=

# --- OCR: how images / scanned PDFs are turned into text ---
#   auto     (default) prefer the offline local engine, fall back to vision LLM
#   rapidocr           offline ONNX engine, no API key, the whole book stays local
#   vision             call the vision LLM routed above (needs a vision API key)
#   none               disable OCR (image/scanned uploads then fail loudly)
OCR_PROVIDER=auto

# Language of the local OCR engine: auto | ch | en | japan | korean | latin |
# cyrillic | chinese_cht | arabic | devanagari
# `auto` runs the bundled Chinese+English model first and re-runs with the
# Japanese model when the mean confidence is below 0.75 — so a Japanese textbook
# with kana is still read correctly without any configuration.
OCR_LANG=auto

# Safety limits: at most N pages per scanned PDF are OCR-ed, and each page image
# is downscaled so its longest side is at most N px before being sent.
OCR_MAX_PAGES=40
OCR_VISION_MAX_SIDE=1800

# Optional explicit task -> provider overrides (JSON), highest priority
# LLM_TASK_ROUTES={"quiz_explain":"deepseek","quiz_generate":"deepseek"}

# Config path. Leave BLANK in local (non-Docker) runs so it falls back to the
# in-repo backend/config/providers.yaml. Only set this inside Docker images.
# The 模型路由诊断 page can also point this at another providers.yaml at runtime;
# that override is stored in backend/config/runtime.json (gitignored) and applied
# on the next request. An environment variable from compose pins it instead.
PROVIDERS_CONFIG_PATH=

# API keys — read from env, never stored in frontend or plaintext DB.
# The backend mirrors .env values into os.environ at startup, so providers can
# read them via the api_key_env name declared in providers.yaml.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible override (any vendor)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Overseas egress: httpx honors these automatically. Never hardcode a proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,minio

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
JWT_EXPIRE_MINUTES=10080
